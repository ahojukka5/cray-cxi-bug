@@ -386,6 +386,7 @@ void cxip_evtq_progress(struct cxip_evtq *evtq)
 		} else {
 
 			req = cxip_evtq_event_req(evtq, event);
+			cxip_diag_event(evtq, event, req);
 			if (req) {
 				ret = req->cb(req, event);
 				if (ret != FI_SUCCESS)
diff --git a/prov/cxi/src/cxip_msg.c b/prov/cxi/src/cxip_msg.c
index 5786edc87..8a163b3ae 100644
--- a/prov/cxi/src/cxip_msg.c
+++ b/prov/cxi/src/cxip_msg.c
@@ -280,6 +280,7 @@ void cxip_recv_req_report(struct cxip_req *req)
 				 err, cxi_rc_to_str(req->recv.rc));
 		}
 
+		cxip_diag_req_error("recv_req_report", req, err, req->recv.rc);
 		ret = cxip_cq_req_error(req, truncated, err, req->recv.rc,
 					NULL, 0, FI_ADDR_UNSPEC);
 		if (ret != FI_SUCCESS)
@@ -674,6 +675,8 @@ void cxip_report_send_completion(struct cxip_req *req, bool sw_cntr)
 			 req->send.caddr.pid, req, ret_err,
 			 cxi_rc_to_str(req->send.rc));
 
