 prov/cxi/include/cxip.h   |   4 +
 prov/cxi/src/cxip_diag.c  | 296 ++++++++++++++++++++++++++++++++++++++
 prov/cxi/src/cxip_evtq.c  |   1 +
 prov/cxi/src/cxip_msg.c   |   3 +
 5 files changed, 305 insertions(+)
 create mode 100644 prov/cxi/src/cxip_diag.c

